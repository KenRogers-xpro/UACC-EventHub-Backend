# Server Configuration
PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database Connection String
# Example: postgresql://neondb_owner:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/uacc_eventhub?sslmode=require

# Authentication & Security
JWT_SECRET=uacc_eventhub_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=8h

# Frontend / Public URL (Used for generating invite links)
BASE_URL=http://localhost:5173

# Cloudinary Configuration (For event cover images & event materials)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Default Initial Admin (Used by npm run db:seed)

